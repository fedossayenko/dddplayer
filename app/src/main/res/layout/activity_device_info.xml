<?xml version="1.0" encoding="utf-8"?>
<!-- Диагностика устройства: разделы с данными об экране, звуке и декодерах, кнопка копирования отчета -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <TextView
        android:id="@+id/diag_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:text="@string/pref_diagnostics"
        android:textColor="@color/tv_white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btn_diag_copy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_diag_copy"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_selector_menu_item"
        android:focusable="true"
        android:clickable="true"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="@string/diag_copy"
        android:textColor="@color/selector_settings_primary"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/diag_header"
        app:layout_constraintEnd_toStartOf="@id/btn_diag_close"
        app:layout_constraintTop_toTopOf="@id/diag_header" />

    <ImageButton
        android:id="@+id/btn_diag_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_selector_menu_item"
        android:contentDescription="@string/close_settings"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/diag_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/diag_header"
        app:tint="@color/selector_settings_primary" />

    <!-- Фокусируемый ScrollView: на пульте Вверх/Вниз прокручивают отчет -->
    <ScrollView
        android:id="@+id/diag_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:paddingHorizontal="48dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/diag_header">

        <LinearLayout
            android:id="@+id/diag_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/diag_progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
