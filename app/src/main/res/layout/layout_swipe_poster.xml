<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка соседнего видео в шторке свайпа (как в плейлисте) -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="192dp"
    android:layout_height="108dp"
    android:visibility="gone"
    app:cardBackgroundColor="@color/bg_placeholder_card"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/swipe_poster_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/pic"
        android:scaleType="fitCenter"
        tools:src="@tools:sample/backgrounds/scenic" />

    <TextView
        android:id="@+id/swipe_poster_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="@color/text_tertiary"
        android:textSize="36sp"
        android:textStyle="bold"
        tools:text="10" />

    <TextView
        android:id="@+id/swipe_poster_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_playlist_number"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:textColor="@color/tv_white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="10"
        tools:visibility="visible" />
</androidx.cardview.widget.CardView>
