<?xml version="1.0" encoding="utf-8"?>
<!-- Пункт категории настроек: фокус - яркий, выбранная категория без фокуса - приглушенная подсветка -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_tertiary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/control_state_focused" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/control_accent_focus" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:drawable="@color/transparent" />
</selector>
